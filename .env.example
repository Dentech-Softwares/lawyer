# M-Pesa Configuration
# Get these from https://developer.safaricom.co.ke after creating a sandbox app
MPESA_ENVIRONMENT=sandbox
MPESA_SANDBOX_CONSUMER_KEY=your_sandbox_consumer_key_here
MPESA_SANDBOX_CONSUMER_SECRET=your_sandbox_consumer_secret_here

# For production (replace with your actual credentials)
# MPESA_ENVIRONMENT=production
# MPESA_BUSINESS_SHORTCODE=your_paybill_or_till_number
# MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# Callback URL - MUST be a publicly accessible HTTPS URL
# For local testing, use ngrok: ngrok http 80
# Then set: MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/lawyer/mpesa_callback.php
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/lawyer/mpesa_callback.php