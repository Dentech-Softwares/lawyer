# M-Pesa Configuration - Safaricom Daraja Sandbox
# Register at https://developer.safaricom.co.ke to create a sandbox app
# and obtain your Consumer Key / Consumer Secret.

# Environment: sandbox (used by default)
MPESA_ENVIRONMENT=sandbox

# Sandbox app credentials (from the Safaricom Developer Portal)
MPESA_SANDBOX_CONSUMER_KEY=your_sandbox_consumer_key_here
MPESA_SANDBOX_CONSUMER_SECRET=your_sandbox_consumer_secret_here

# Sandbox shortcode and passkey (use Safaricom's published test values or
# your own if you have been assigned a custom shortcode)
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbc158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c9192

# Callback URL — MUST be a publicly accessible HTTPS endpoint.
# For local testing, use a tunnel such as ngrok:
#   ngrok http 80
# Then set the URL to your tunnel address, e.g.:
#   MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/lawyer/mpesa_callback.php
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/lawyer/mpesa_callback.php

# -------------------------------------------------------------------
# For production (uncomment and replace with real credentials)
# -------------------------------------------------------------------
# MPESA_ENVIRONMENT=production
# MPESA_SANDBOX_CONSUMER_KEY=your_production_consumer_key_here
# MPESA_SANDBOX_CONSUMER_SECRET=your_production_consumer_secret_here
# MPESA_BUSINESS_SHORTCODE=your_paybill_or_till_number
# MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# MPESA_CALLBACK_URL=https://yourdomain.com/mpesa_callback.php
